# Docker Compose environment — copy to .env before: docker compose up -d
POSTGRES_USER=harkat
POSTGRES_PASSWORD=harkat
POSTGRES_DB=harkat

DATABASE_URL=postgresql://harkat:harkat@postgres:5432/harkat?schema=public
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
PORT=3000
UPLOAD_DIR=/app/uploads

# Set true on first deploy to seed demo users + 527 students
RUN_SEED=true

# Host port mappings (change if 3000/5433 already in use)
API_PORT=3000
POSTGRES_PORT=5434
